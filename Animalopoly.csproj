  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="LsMsgPack">
      <HintPath>LsMsgPack.dll</HintPath>
    </Reference>
    <Reference Include="NetProcessing">
      <HintPath>NetProcessing.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
